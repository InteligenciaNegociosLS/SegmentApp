# ============================================================
# Migración Firebase → Supabase · variables (EJEMPLO)
# Copia este archivo como ".env" EN CLOUD SHELL y llénalo.
# El .env nunca se sube a GitHub. Nunca pegues estos valores en el chat.
# ============================================================

# pruebas | produccion   (empieza SIEMPRE por pruebas)
DESTINO=pruebas

# Supabase → botón "Connect" → pestaña "Session pooler" → copiar la URI
# y reemplazar [YOUR-PASSWORD] por la clave de la base de datos.  SECRETO.
SUPABASE_DB_URL=

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → "Secret key" (o "service_role").  SECRETO.
# Solo la usa el paso 3 (usuarios).
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto de Firebase a exportar
FIREBASE_PROJECT_ID=segmentapp-1b237
