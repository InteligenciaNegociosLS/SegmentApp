# ============================================================
# SegmentApp - Variables de entorno (EJEMPLO, sin valores reales)
#
# - En Vercel se configuran en: Settings → Environment Variables.
# - En tu computadora: copia este archivo como ".env" y llénalo.
#   El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# - Detalle de qué va en Preview y qué en Production: docs/ENTORNOS.md
# ============================================================

# --- Entorno -------------------------------------------------
# production | preview | development
# En Vercel NO hace falta: se detecta solo (VERCEL_ENV).
APP_ENV=development

# --- Supabase (valores PÚBLICOS: van al navegador) -----------
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API → clave "anon" / "publishable".
# ¡NUNCA la "service_role" / "secret"! (la construcción se detiene si la detecta)
SUPABASE_ANON_KEY=

# --- Registro de fallas --------------------------------------
# true = además de guardarlas en el dispositivo, enviarlas a Supabase
# (tabla app_errores, se crea en la Fase 3). Dejar en false hasta entonces.
ERROR_LOG_REMOTE=false

# ============================================================
# SOLO PARA SCRIPTS QUE EJECUTA EL DUEÑO (Cloud Shell / su PC).
# NUNCA en Vercel. NUNCA en el navegador.
# ============================================================
# Supabase → Project Settings → API → clave "service_role" / "secret"
SUPABASE_SERVICE_ROLE_KEY=
# Proyecto de Firebase de donde se migran los datos (Fase 4)
FIREBASE_PROJECT_ID=segmentapp-1b237
